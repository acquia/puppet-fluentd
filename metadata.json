      "operatingsystemrelease": [ "7", "8", "9" ]
    },
    {
      "operatingsystem": "CentOS",
      "operatingsystemrelease": [ "6",  "7", "8" ]
    },
    {
      "operatingsystem": "Amazon",
      "operatingsystemrelease": [ "2", "2023" ]
    }
  ],
  "dependencies": [
    { "name": "puppetlabs/stdlib", "version_requirement": ">= 9.0.0 < 10.0.0" },
    { "name": "puppetlabs/apt", "version_requirement": ">= 9.4.0" }
  ],
  "data_provider": null
}

